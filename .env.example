# ==============================================================
# CyberNeura — Environment Configuration
# Copy this file to .env and fill in your values
# ==============================================================

# --- Application ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# --- PostgreSQL ---
DATABASE_URL=postgresql://cyberneura:cyberneura_secret@localhost:5432/cyberneura_db
POSTGRES_USER=cyberneura
POSTGRES_PASSWORD=cyberneura_secret
POSTGRES_DB=cyberneura_db

# --- Security ---
# Generate with: openssl rand -base64 32
API_SECRET_KEY=replace_with_a_strong_secret_key
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# --- Google Safe Browsing API ---
# Get from: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=YOUR_GSB_API_KEY_HERE
GOOGLE_SAFE_BROWSING_CLIENT_ID=cyberneura
GOOGLE_SAFE_BROWSING_CLIENT_VERSION=1.0.0

# --- PhishTank ---
# Register at: https://www.phishtank.com/api_info.php
PHISHTANK_API_KEY=YOUR_PHISHTANK_API_KEY_HERE
# Download URL (with key): http://data.phishtank.com/data/{KEY}/online-valid.json
# Public URL (no key, rate limited): http://data.phishtank.com/data/online-valid.json
PHISHTANK_FEED_URL=http://data.phishtank.com/data/online-valid.json

# --- OpenPhish ---
# Community feed (free, no key needed)
OPENPHISH_FEED_URL=https://openphish.com/feed.txt

# --- URLhaus ---
# No API key required for the free text feed
URLHAUS_FEED_URL=https://urlhaus.abuse.ch/downloads/text/

# --- Threat Feed Sync ---
# Cron expression for feed sync (default: every 30 minutes)
FEED_SYNC_CRON=*/30 * * * *
# Number of URLs to pipeline-batch into Redis at once
REDIS_PIPELINE_BATCH_SIZE=1000

# --- AI Microservice ---
# Python FastAPI stub service URL
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=5000
AI_SERVICE_ENABLED=false

# --- Whitelist ---
# Path to top domains list loaded into Redis on startup
WHITELIST_FILE_PATH=./data/top-1m-domains.txt

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
