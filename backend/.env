# ─── Server ─────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── PostgreSQL ─────────────────────────────────────────────
DATABASE_URL=postgresql://cyberneura:cyberneura@localhost:5432/cyberneura

# ─── Threat Intelligence API Keys ───────────────────────────
# Get from: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_KEY=YOUR_GSB_API_KEY_HERE

# Optional — increases PhishTank rate limit
# Get from: https://www.phishtank.com/api_info.php
PHISHTANK_API_KEY=

# ─── AI Microservice ────────────────────────────────────────
# Set to true when ai-service/ is running
AI_SERVICE_ENABLED=true
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=5000

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
SCAN_RATE_LIMIT_MAX=20

# ─── CORS ───────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=debug
